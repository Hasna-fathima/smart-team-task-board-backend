# .gitignore for MERN-Assignment
# Ignore backend and frontend node_modules
/backend/node_modules/
/frontend/node_modules/

# Ignore build output directories
/backend/dist/
/frontend/build/

# OS and editor files
.DS_Store
Thumbs.db

# Logs
npm-debug.log
yarn-debug.log
yarn-error.log


# Environment files (should not be committed)
backend/.env
backend/.env.example
